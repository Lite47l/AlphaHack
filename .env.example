# Скопируйте в .env и при необходимости заполните. Файл .env не обязателен:
# без него проект стартует (`docker compose up --build`), LLM выключена (режим rules).
# Не коммитьте .env — в нём секреты.

# ---------- Go-шлюз (backend) ----------
PORT=8080
APP_ENV=dev
# debug | info | warn | error
LOG_LEVEL=info
# Для локального запуска вне Docker (в compose задаётся автоматически).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hackathon?sslmode=disable
SHUTDOWN_TIMEOUT_SECONDS=10
# Адрес AI-сервиса для проксирования /api/v1/{companies,insights,relevance,bank,system,metrics}.
# В compose всегда http://ai:8000; для локального запуска — например http://localhost:8000.
AI_URL=http://localhost:8000
# Лимит POST /api/v1/insights, POST /api/v1/insights/{id}/chat и POST /api/v1/news на IP (запросов в минуту).
RATE_LIMIT_PER_MINUTE=20
# POST /api/v1/news с url: загрузка страниц защищена от SSRF (запрещены loopback/private/link-local/multicast
# и служебные диапазоны). Если VPN/прокси на машине подменяет DNS «fake-IP» адресами (например 198.18.0.0/15
# или 240.0.0.0/4), перечислите эти диапазоны через запятую. Loopback/private разрешить нельзя.
FETCH_ALLOW_CIDRS=

# ---------- Сбор новостей ----------
# RSS-источники в формате "Имя|url;Имя|url". Пусто — набор по умолчанию:
# Банк России, Банк России (события), РБК, Ведомости, Коммерсантъ, Лента.ру Экономика, Banki.ru.
NEWS_FEEDS=
# Период фонового импорта (Go duration: 15m, 1h). 0 — только при старте и вручную.
NEWS_IMPORT_INTERVAL=30m
# Импорт при старте шлюза (true/false).
NEWS_IMPORT_ON_START=true
# Снимок новостей для запуска без сети; загружается, если таблица news пуста.
NEWS_SNAPSHOT_PATH=/data/news_snapshot.json

# ---------- AI-сервис ----------
# Минимальная выручка компании (руб.) для выборки профилей. Крупный бизнес по кейсу — от 15 млрд
# (помечается в профиле); 5–15 млрд оставлены как расширенная выборка для контрастных сравнений.
SEGMENT_MIN_REVENUE=5000000000

# OpenAI-совместимый API моделей организаторов. Пустые LLM_BASE_URL/LLM_API_KEY — LLM выключена.
# Запасной адрес для российских хостингов: https://api.alfahack-gateway26.ru/v1
LLM_BASE_URL=https://changellenge.up.railway.app/v1
# Ключ команды (sk-...). Только в .env, никогда в git и не во фронтенде.
LLM_API_KEY=
# Путь к дополнительному CA-сертификату для LLM_BASE_URL (внутри контейнера ai), если нужен.
LLM_CA_FILE=
# Точные имена моделей из списка организаторов (модели вне allowlist отклоняются кодом).
LLM_MODEL_PLANNER=z-ai/glm-5.3-flash
LLM_MODEL_EXTRACTOR=google/gemma-4-26b-a4b-it
LLM_MODEL_WRITER=qwen/qwen3.6-35b-a3b
LLM_MODEL_CHAT=qwen/qwen3.6-35b-a3b
# Суточный бюджет токенов; при исчерпании — режим rules.
LLM_DAILY_TOKEN_BUDGET=1500000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2200

# Ограничения агента.
AGENT_MAX_STEPS=12
AGENT_MAX_SECONDS=150
AGENT_MAX_REPAIRS=1
# Окно ленты новостей (дней).
FEED_WINDOW_DAYS=45

# Парсер РБК (необязательный сервис, compose profile "rbc"). Пусто — коллектор РБК выключен.
# Включение: RBC_PARSER_URL=http://rbc-parser:8000 и docker compose --profile rbc up --build
RBC_PARSER_URL=
RBC_QUERY=экономика
# PDF для POST /api/v1/knowledge/collect кладутся в ./data/knowledge (в контейнере /data/knowledge, не в git).
